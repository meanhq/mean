{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mean.app/schemas/dom/v1.json",
  "oneOf": [
    {
      "$ref": "#/$defs/walk"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/probe"
    },
    {
      "$ref": "#/$defs/probeResult"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "probe": {
      "type": "object",
      "required": [
        "v",
        "type",
        "requestId"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "probe"
        },
        "requestId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "probeResult": {
      "type": "object",
      "required": [
        "v",
        "type",
        "requestId",
        "title",
        "visible",
        "focused",
        "viewport"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "probe.result"
        },
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "visible": {
          "type": "boolean"
        },
        "focused": {
          "type": "boolean"
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "v",
        "type",
        "requestId",
        "code"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "error"
        },
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "code": {
          "enum": [
            "stale",
            "busy",
            "unsupported_viewport",
            "unsupported_type",
            "invalid_request",
            "internal"
          ]
        }
      }
    },
    "relay": {
      "type": "object",
      "required": [
        "v",
        "type",
        "pageId"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "pageId": {
          "$ref": "#/$defs/uuid"
        }
      },
      "oneOf": [
        {
          "required": [
            "message"
          ],
          "properties": {
            "type": {
              "const": "page.message"
            },
            "message": {
              "$ref": "#"
            }
          }
        },
        {
          "required": [
            "origin"
          ],
          "properties": {
            "type": {
              "const": "page.open"
            },
            "origin": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^https?://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]{1,5})?$"
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "page.close"
            }
          }
        }
      ]
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "rect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "screenRect": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        }
      }
    },
    "viewport": {
      "type": "object",
      "required": [
        "width",
        "height",
        "dpr"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "dpr": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "file",
        "line"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "element": {
      "type": "object",
      "required": [
        "rect",
        "tag",
        "classes",
        "framework",
        "depth"
      ],
      "properties": {
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "classes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "elementPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "component": {
          "$ref": "#/$defs/name"
        },
        "chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "framework": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        }
      }
    },
    "walk": {
      "type": "object",
      "required": [
        "v",
        "type",
        "requestId",
        "probeId",
        "webArea",
        "deviceScale"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "walk"
        },
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "probeId": {
          "$ref": "#/$defs/uuid"
        },
        "webArea": {
          "$ref": "#/$defs/screenRect"
        },
        "deviceScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 16
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "v",
        "type",
        "requestId",
        "viewport",
        "elements",
        "truncated"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "walk.result"
        },
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "elements": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "part": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "more": {
          "type": "boolean"
        }
      }
    }
  }
}
